{
  "name": "@hybrid/config",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared configuration boundary. Browser-safe values on the root export; server-only configuration behind ./server.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "20.19.43"
  }
}
