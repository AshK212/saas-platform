# AI Hybrid Multi-Agent Platform - example environment file.
#
# Copy to `.env` for local development:   cp .env.example .env
# NEVER commit a real `.env`. All values below are placeholders or empty.
# Secrets are supplied at runtime by the environment (Render env vars), never by Git.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
HOST=127.0.0.1

# ---------------------------------------------------------------------------
# Public URLs
#
# APP_URL is consumed by authentication (see below) to build sign-in links and
# as the sole post-callback redirect destination. Must be an absolute http(s)
# URL. In the same-site deployment this is also where the API is reachable.
# ---------------------------------------------------------------------------
APP_URL=http://localhost:5173
API_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Database - Neon PostgreSQL
# Consumed by packages/db and Drizzle migrations. SERVER-SIDE ONLY.
#
# Optional: the API starts without it and GET /healthz still returns 200.
# GET /readyz then reports {"database":"unconfigured"} with HTTP 503.
# Database-dependent operations (migrations) fail loudly at the point of use.
#
# When set it MUST be a valid postgres:// or postgresql:// URL - there is no
# fallback value in any environment. Empty is treated as "not configured".
#
# Format (Neon supplies this; the value below is a placeholder, not a secret):
#   postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require
#
# Use Neon's DIRECT (unpooled) connection string for migrations, and the
# POOLED (-pooler) string for the running API. See docs/deployment.md.
# ---------------------------------------------------------------------------
DATABASE_URL=

# ---------------------------------------------------------------------------
# Authentication (Step 5) - magic-link sign-in
#
# All optional: if any is missing the auth routes return 503 and the process
# still starts. GET /healthz is never affected.
#
# APP_URL is the absolute browser-app origin. It builds the emailed sign-in
# link and is the ONLY redirect destination after the callback, so there is no
# open redirect. There is no localhost fallback in production.
#
# RESEND_API_KEY is a SECRET: server-side only, never logged, never returned,
# and never exposed to the browser.
#
# AUTH_FROM_EMAIL must be a sender verified in the Resend account.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
AUTH_FROM_EMAIL=

# ---------------------------------------------------------------------------
# Cross-origin browser app - OPTIONAL
#
# Leave EMPTY for the intended same-site deployment (web and API on one origin),
# where no CORS is involved and SameSite=Lax cookies work normally.
#
# Set it only for a split-origin deployment, which also requires
# SameSite=None; Secure cookies and weakens the CSRF posture.
# See docs/authentication.md.
# ---------------------------------------------------------------------------
WEB_ORIGIN=

# ---------------------------------------------------------------------------
# Web (Vite)
# Only VITE_*-prefixed values reach the browser bundle.
# NEVER put a secret behind a VITE_ prefix.
# ---------------------------------------------------------------------------
VITE_API_URL=http://localhost:3000
