# AI Hybrid Multi-Agent Platform - example environment file.
#
# Copy to `.env` for local development:   cp .env.example .env
# NEVER commit a real `.env`. All values below are placeholders or empty.
# Secrets are supplied at runtime by the environment (Render env vars), never by Git.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
HOST=127.0.0.1

# ---------------------------------------------------------------------------
# Public URLs
# ---------------------------------------------------------------------------
APP_URL=http://localhost:5173
API_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Database - Neon PostgreSQL
# Consumed by packages/db and Drizzle migrations. SERVER-SIDE ONLY.
#
# Optional: the API starts without it and GET /healthz still returns 200.
# GET /readyz then reports {"database":"unconfigured"} with HTTP 503.
# Database-dependent operations (migrations) fail loudly at the point of use.
#
# When set it MUST be a valid postgres:// or postgresql:// URL - there is no
# fallback value in any environment. Empty is treated as "not configured".
#
# Format (Neon supplies this; the value below is a placeholder, not a secret):
#   postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require
#
# Use Neon's DIRECT (unpooled) connection string for migrations, and the
# POOLED (-pooler) string for the running API. See docs/deployment.md.
# ---------------------------------------------------------------------------
DATABASE_URL=

# ---------------------------------------------------------------------------
# Email - Resend
# Reserved for a later step (magic-link sign-in). Not used in Step 1.
# ---------------------------------------------------------------------------
RESEND_API_KEY=

# ---------------------------------------------------------------------------
# Web (Vite)
# Only VITE_*-prefixed values reach the browser bundle.
# NEVER put a secret behind a VITE_ prefix.
# ---------------------------------------------------------------------------
VITE_API_URL=http://localhost:3000
